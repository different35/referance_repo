# Caddyfile — otomatik HTTPS reverse proxy
# DNS A kaydı PUBLIC_DOMAIN'i bu sunucunun IP'sine yönlendirmelidir.
# Lokal geliştirme için: PUBLIC_DOMAIN=localhost (Caddy self-signed cert üretir)

{
	email {$LETSENCRYPT_EMAIL}
	# Lokal test için staging CA kullanmak isterseniz açın:
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

{$PUBLIC_DOMAIN} {
	encode zstd gzip

	# Sağlık kontrolü
	handle /health {
		reverse_proxy server:3000
	}

	# Backend API (REST + tRPC + WebSocket)
	handle /api/* {
		reverse_proxy server:3000
	}

	handle /trpc/* {
		reverse_proxy server:3000
	}

	# Frontend (PWA)
	handle {
		reverse_proxy web:80
	}

	# Güvenlik başlıkları
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(self), camera=(self), microphone=(self)"
	}
}
