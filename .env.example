# ─────────────────────────────────────────────────────────
# Swarm Panel — Environment Variables
# Copy this file to .env and fill in values.
# ─────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ── Server ───────────────────────────────────────────────
SERVER_PORT=3000
SERVER_HOST=0.0.0.0

# ── Web (Vite dev server) ────────────────────────────────
WEB_PORT=5173
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000

# ── Database (SQLite path inside server container/host) ──
DATABASE_URL=file:./data/swarm.db

# ── Better-Auth ──────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-32-byte-base64-secret
BETTER_AUTH_URL=http://localhost:3000

# ── Anthropic (Ads module + Claude CLI) ──────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── VSCode Bridge ────────────────────────────────────────
VSCODE_BRIDGE_PORT=3001
VSCODE_BRIDGE_API_KEY=change-me-random-32-bytes

# ── Public deployment (production) ───────────────────────
PUBLIC_DOMAIN=panel.example.com
LETSENCRYPT_EMAIL=admin@example.com

# ── Push notifications (VAPID keys for Web Push) ─────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
